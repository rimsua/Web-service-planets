<div
  id="react-root"
  data-page="universe"
  data-user-nickname="<%= Current.user.nickname %>"
  data-star-systems="<%= h(@star_systems.map { |system|
    system.as_json(only: [:id, :name, :star_type]).merge(
      planet_count: system.planets.size,
      owner_nickname: system.user.nickname
    )
  }.to_json) %>"
  data-star-type-labels="<%= h(StarSystem::STAR_TYPE_LABELS.to_json) %>"
  data-flash-alert="<%= h(flash[:alert].to_s) %>"
  data-flash-notice="<%= h(flash[:notice].to_s) %>"
></div>