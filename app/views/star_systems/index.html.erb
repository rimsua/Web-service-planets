<div
  id="react-root"
  data-page="star-systems"
  data-user-nickname="<%= h(Current.user.nickname) %>"
  data-star-systems="<%= h(Current.user.star_systems.includes(:planets).order(created_at: :desc).map { |system| system.as_json(only: [:id, :name, :star_type, :published]).merge(planet_count: system.planets.size) }.to_json) %>"
  data-star-system-limit="<%= User::MAX_STAR_SYSTEMS %>"
  data-star-type-labels="<%= h(StarSystem::STAR_TYPE_LABELS.to_json) %>"
  data-flash-alert="<%= h(flash[:alert].to_s) %>"
  data-flash-notice="<%= h(flash[:notice].to_s) %>"
></div>