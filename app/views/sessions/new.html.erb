<div class="auth-page">

  <div class="auth-card">

    <div class="auth-status auth-status--logged-out">
      <span class="auth-status__dot"></span>
      Вы не авторизованы
    </div>

    <h1>Вход</h1>

    <% if flash[:alert] %>
      <div class="auth-errors" role="alert">
        <p><%= flash[:alert] %></p>
      </div>
    <% end %>

    <%= form_with url: session_path,
              html: { class: "auth-form", novalidate: true } do |form| %>
      <div>
        <%= form.label :email_address, "Email" %>

        <%= form.email_field :email_address,
            required: true,
            autofocus: true,
            autocomplete: "email" %>
      </div>

      <div>
        <%= form.label :password, "Пароль" %>

        <%= form.password_field :password,
            required: true,
            autocomplete: "current-password" %>
      </div>

      <div>
        <%= form.submit "Войти", class: "btn btn--primary auth-form__submit" %>
      </div>
    <% end %>

    <p>
      Нет аккаунта?
      <%= link_to "Зарегистрироваться", sign_up_path %>
    </p>

  </div>

</div>